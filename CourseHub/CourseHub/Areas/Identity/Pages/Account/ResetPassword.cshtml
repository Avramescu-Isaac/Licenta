@page
@model ResetPasswordModel
@{
    ViewData["Title"] = Model.ShowEmailField ? Localizer["Resetează Parola"] : Localizer["Setează Parola Nouă"];
    var processingText = Localizer["Se procesează..."].Value;
}

<style>
    .reset-container {
        max-width: 440px;
        margin: 60px auto;
        padding: 48px 40px;
        background: white;
        border-radius: 16px;
        box-shadow: 0 4px 24px rgba(0, 0, 0, 0.08);
    }

    .reset-icon {
        text-align: center;
        font-size: 56px;
        margin-bottom: 8px;
        display: block;
    }

    .reset-title {
        text-align: center;
        color: #1f2937;
        font-size: 26px;
        font-weight: 700;
        margin-bottom: 4px;
    }

    .reset-subtitle {
        text-align: center;
        color: #6b7280;
        font-size: 15px;
        margin-bottom: 32px;
        line-height: 1.6;
    }

    .form-group-modern {
        margin-bottom: 20px;
    }

    .form-group-modern label {
        display: block;
        font-weight: 500;
        color: #374151;
        margin-bottom: 6px;
        font-size: 14px;
    }

    .form-group-modern .input-wrapper {
        position: relative;
    }

    .form-group-modern input {
        width: 100%;
        padding: 12px 16px;
        padding-left: 44px;
        border: 2px solid #e5e7eb;
        border-radius: 10px;
        font-size: 15px;
        transition: all 0.3s ease;
        background: #f9fafb;
        box-sizing: border-box;
    }

    .form-group-modern input:focus {
        outline: none;
        border-color: #1f2937;
        background: white;
        box-shadow: 0 0 0 4px rgba(31, 41, 55, 0.08);
        transform: translateY(-1px);
    }

    .form-group-modern input:hover {
        border-color: #9ca3af;
        background: white;
    }

    .form-group-modern .input-icon {
        position: absolute;
        left: 14px;
        top: 50%;
        transform: translateY(-50%);
        color: #9ca3af;
        font-size: 18px;
    }

    .field-validation-error {
        color: #dc2626;
        font-size: 13px;
        margin-top: 4px;
        display: block;
    }

    .validation-summary {
        background: #fef2f2;
        border: 1px solid #fecaca;
        border-radius: 8px;
        padding: 12px 16px;
        margin-bottom: 20px;
        color: #dc2626;
    }

    .alert-success {
        background: #f0fdf4;
        border: 1px solid #bbf7d0;
        border-radius: 8px;
        padding: 16px;
        margin-bottom: 20px;
        color: #16a34a;
        text-align: center;
    }

    .alert-success .checkmark {
        font-size: 32px;
        display: block;
        margin-bottom: 8px;
    }

    .btn-submit {
        width: 100%;
        padding: 14px;
        background: #1f2937;
        color: white;
        border: none;
        border-radius: 10px;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        margin-top: 8px;
    }

    .btn-submit:hover {
        background: #374151;
        transform: translateY(-2px);
        box-shadow: 0 4px 16px rgba(31, 41, 55, 0.25);
    }

    .btn-submit:active {
        transform: translateY(0);
    }

    .btn-submit:disabled {
        opacity: 0.6;
        cursor: not-allowed;
        transform: none;
    }

    .login-link {
        text-align: center;
        margin-top: 24px;
        padding-top: 20px;
        border-top: 1px solid #e5e7eb;
    }

    .login-link a {
        color: #1f2937;
        text-decoration: none;
        font-weight: 500;
        transition: all 0.2s;
        padding: 4px 8px;
        border-radius: 4px;
    }

    .login-link a:hover {
        background: #f3f4f6;
        text-decoration: underline;
    }

    .password-strength {
        height: 4px;
        border-radius: 2px;
        margin-top: 6px;
        background: #e5e7eb;
        transition: all 0.3s;
        overflow: hidden;
    }

    .password-strength .bar {
        height: 100%;
        width: 0%;
        border-radius: 2px;
        transition: width 0.4s ease;
    }

    .password-strength .bar.weak { width: 33%; background: #dc2626; }
    .password-strength .bar.medium { width: 66%; background: #f59e0b; }
    .password-strength .bar.strong { width: 100%; background: #16a34a; }

    .toggle-password {
        position: absolute;
        right: 14px;
        top: 50%;
        transform: translateY(-50%);
        background: none;
        border: none;
        color: #9ca3af;
        cursor: pointer;
        font-size: 18px;
        padding: 4px;
        transition: all 0.2s;
    }

    .toggle-password:hover {
        color: #374151;
    }

    .spinner {
        display: inline-block;
        width: 18px;
        height: 18px;
        border: 3px solid rgba(255, 255, 255, 0.3);
        border-radius: 50%;
        border-top-color: #fff;
        animation: spin 0.8s ease-in-out infinite;
        margin-right: 8px;
        vertical-align: middle;
    }

    @@keyframes spin {
        to { transform: rotate(360deg); }
    }

    .step-indicator {
        display: flex;
        justify-content: center;
        gap: 12px;
        margin-bottom: 24px;
    }

    .step-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: #e5e7eb;
        transition: all 0.3s;
    }

    .step-dot.active {
        background: #1f2937;
        transform: scale(1.2);
    }

    .step-dot.completed {
        background: #059669;
    }

    @@media (max-width: 640px) {
        .reset-container {
            padding: 32px 24px;
            margin: 20px 16px;
        }
    }
</style>

<div class="reset-container">
    <span class="reset-icon">@(Model.ShowEmailField ? "" : "")</span>
    <h1 class="reset-title">@ViewData["Title"]</h1>
    
    @if (Model.ShowEmailField)
    {
        <p class="reset-subtitle">
            @Localizer["Introdu adresa de email și îți vom trimite"]<br />
            @Localizer["un link pentru a-ți reseta parola."]
        </p>
    }
    else
    {
        <p class="reset-subtitle">
            @Localizer["Creează o parolă nouă pentru contul tău."]
        </p>
    }

    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="alert-success">
            @Model.StatusMessage
        </div>
    }

    <!-- Step Indicators -->
    <div class="step-indicator">
        <div class="step-dot @(Model.ShowEmailField ? "active" : "completed")"></div>
        <div class="step-dot @(Model.ShowEmailField ? "" : "active")"></div>
    </div>

    <form method="post">
        <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>

        @if (Model.ShowEmailField)
        {
            <!-- STEP 1: Email Input -->
            <div class="form-group-modern">
                <label asp-for="Input.Email">@Localizer["Adresă de email"]</label>
                <div class="input-wrapper">
                    <input asp-for="Input.Email" class="form-control" autocomplete="email" aria-required="true" placeholder="nume@exemplu.com" />
                </div>
                <span asp-validation-for="Input.Email" class="field-validation-error"></span>
            </div>

            <button type="submit" class="btn-submit" id="submitBtn">
                <span class="spinner" id="submitSpinner" style="display: none;"></span>
                <span id="submitText">@Localizer["Trimite linkul de resetare"]</span>
            </button>
        }
        else
        {
            <!-- STEP 2: New Password -->
            <input asp-for="Input.Code" type="hidden" />
            <input asp-for="Input.Email" type="hidden" />

            <div class="form-group-modern">
                <label asp-for="Input.Password">@Localizer["Parolă nouă"]</label>
                <div class="input-wrapper">
                    <input asp-for="Input.Password" id="resetPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="@Localizer["Creează parola nouă"]" oninput="checkPasswordStrength(this.value)" />
                    <button type="button" class="toggle-password" onclick="togglePassword()">@Localizer["Arată"]</button>
                </div>
                <div class="password-strength" id="strengthIndicator">
                    <div class="bar" id="strengthBar"></div>
                </div>
                <span asp-validation-for="Input.Password" class="field-validation-error"></span>
            </div>

            <div class="form-group-modern">
                <label asp-for="Input.ConfirmPassword">@Localizer["Confirmă parola"]</label>
                <div class="input-wrapper">
                    <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="@Localizer["Confirmă parola"]" />
                </div>
                <span asp-validation-for="Input.ConfirmPassword" class="field-validation-error"></span>
            </div>

            <button type="submit" class="btn-submit" id="submitBtn">
                <span class="spinner" id="submitSpinner" style="display: none;"></span>
                <span id="submitText">@Localizer["Resetează Parola"]</span>
            </button>
        }

        <div class="login-link">
            <a asp-page="./Login">@Localizer["Înapoi la autentificare"]</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const processingText = @Html.Raw(Json.Serialize(processingText));

        // Toggle password visibility
        function togglePassword() {
            const input = document.getElementById('resetPassword');
            const button = event.target;
            if (input && input.type === 'password') {
                input.type = 'text';
                button.textContent = 'Ascunde';
            } else if (input) {
                input.type = 'password';
                button.textContent = 'Arată';
            }
        }

        // Password strength checker
        function checkPasswordStrength(password) {
            const bar = document.getElementById('strengthBar');
            if (!bar) return;
            
            let strength = 0;
            if (password.length >= 8) strength++;
            if (password.match(/[a-z]/)) strength++;
            if (password.match(/[A-Z]/)) strength++;
            if (password.match(/[0-9]/)) strength++;
            if (password.match(/[^a-zA-Z0-9]/)) strength++;

            bar.className = 'bar';
            if (password.length === 0) {
                bar.style.width = '0%';
                return;
            }

            if (strength <= 2) {
                bar.classList.add('weak');
            } else if (strength <= 3) {
                bar.classList.add('medium');
            } else {
                bar.classList.add('strong');
            }
        }

        // Form submit handling
        document.querySelector('form').addEventListener('submit', function() {
            const btn = document.getElementById('submitBtn');
            const spinner = document.getElementById('submitSpinner');
            const text = document.getElementById('submitText');
            
            if (btn) {
                btn.disabled = true;
                if (spinner) spinner.style.display = 'inline-block';
                if (text) text.textContent = processingText;
                btn.style.opacity = '0.7';
            }
        });

        // Add focus effects
        document.querySelectorAll('.form-group-modern input').forEach(input => {
            input.addEventListener('focus', function() {
                const label = this.closest('.form-group-modern')?.querySelector('label');
                if (label) label.style.color = '#1f2937';
            });
            input.addEventListener('blur', function() {
                const label = this.closest('.form-group-modern')?.querySelector('label');
                if (label) label.style.color = '#374151';
            });
        });
    </script>
}
