@using CourseHub.Models
@using CourseHub.Areas.Identity.Pages.Account.Manage
@inject SignInManager<ApplicationUser> SignInManager
@{
    var hasExternalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).Any();
}

<style>
    .manage-nav {
        display: flex;
        flex-direction: column;
        gap: 4px;
        padding: 0;
        list-style: none;
    }

        .manage-nav .nav-item {
            width: 100%;
        }

        .manage-nav .nav-link {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 16px;
            border-radius: 10px;
            color: #374151;
            text-decoration: none;
            font-weight: 500;
            transition: all 0.2s ease;
            background: transparent;
            border: none;
            width: 100%;
            text-align: left;
            font-size: 15px;
        }

            .manage-nav .nav-link:hover {
                background: #f3f4f6;
                color: #1f2937;
                transform: translateX(4px);
            }

            .manage-nav .nav-link.active {
                background: #1f2937;
                color: white;
                box-shadow: 0 2px 8px rgba(31, 41, 55, 0.15);
            }

                .manage-nav .nav-link.active:hover {
                    background: #374151;
                    transform: translateX(4px);
                }

        .manage-nav .nav-icon {
            font-size: 18px;
            width: 24px;
            text-align: center;
        }

        .manage-nav .nav-text {
            flex: 1;
        }

        .manage-nav .nav-badge {
            background: #e5e7eb;
            color: #6b7280;
            padding: 2px 10px;
            border-radius: 12px;
            font-size: 12px;
            font-weight: 600;
        }

        .manage-nav .nav-link.active .nav-badge {
            background: rgba(255, 255, 255, 0.2);
            color: rgba(255, 255, 255, 0.8);
        }

    @@media (max-width: 768px) {
        .manage-nav {
            flex-direction: row;
            flex-wrap: wrap;
            gap: 6px;
        }

            .manage-nav .nav-item {
                flex: 1;
                min-width: 120px;
            }

            .manage-nav .nav-link {
                padding: 10px 14px;
                font-size: 14px;
                justify-content: center;
            }

                .manage-nav .nav-link:hover {
                    transform: none;
                }

                .manage-nav .nav-link.active:hover {
                    transform: none;
                }

            .manage-nav .nav-text {
                display: none;
            }

            .manage-nav .nav-badge {
                display: none;
            }
    }

    @@media (max-width: 480px) {
        .manage-nav .nav-item {
            min-width: 80px;
        }

        .manage-nav .nav-link {
            padding: 8px 12px;
            font-size: 13px;
        }

        .manage-nav .nav-icon {
            font-size: 16px;
            width: 20px;
        }
    }
</style>

<ul class="manage-nav">
    <li class="nav-item">
        <a class="nav-link @ManageNavPages.IndexNavClass(ViewContext)" asp-page="./Index">
            <span class="nav-text">@Localizer["Profil"]</span>
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @ManageNavPages.ChangePasswordNavClass(ViewContext)" asp-page="./ChangePassword">
            <span class="nav-text">@Localizer["Parolă"]</span>
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @ManageNavPages.EditProfileNavClass(ViewContext)" asp-page="./EditProfile">
            <span class="nav-text">@Localizer["Editează Profilul"]</span>
        </a>
    </li>
    @if (hasExternalLogins)
    {
        <li id="external-logins" class="nav-item">
            <a id="external-login" class="nav-link @ManageNavPages.ExternalLoginsNavClass(ViewContext)" asp-page="./ExternalLogins">
                <span class="nav-text">@Localizer["Autentificări Externe"]</span>
            </a>
        </li>
    }
</ul>
