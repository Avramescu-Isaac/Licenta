@page
@model CourseHub.Areas.Identity.Pages.Account.Manage.EditProfileModel
@{
    ViewData["Title"] = Localizer["Editează Profilul"];
    ViewData["ActivePage"] = ManageNavPages.EditProfile;
    var i18n = new
    {
        maxTopics = Localizer["Poți selecta maximum 3 materii!"].Value,
        sending = Localizer["Se trimite..."].Value,
        saving = Localizer["Se salvează..."].Value
    };
}

<style>
    .edit-profile-container {
        max-width: 600px;
        margin: 0 auto;
        padding: 20px 0;
    }

    .edit-profile-title {
        color: #1f2937;
        font-size: 24px;
        font-weight: 700;
        margin-bottom: 4px;
    }

    .edit-profile-subtitle {
        color: #6b7280;
        font-size: 15px;
        margin-bottom: 24px;
    }

    .form-group-modern {
        margin-bottom: 20px;
    }

        .form-group-modern label {
            display: block;
            font-weight: 500;
            color: #374151;
            margin-bottom: 6px;
            font-size: 14px;
        }

        .form-group-modern .input-wrapper {
            position: relative;
        }

        .form-group-modern input,
        .form-group-modern textarea,
        .form-group-modern select {
            width: 100%;
            padding: 12px 16px;
            border: 2px solid #e5e7eb;
            border-radius: 10px;
            font-size: 15px;
            transition: all 0.3s ease;
            background: #f9fafb;
            box-sizing: border-box;
            font-family: inherit;
        }

            .form-group-modern input:focus,
            .form-group-modern textarea:focus,
            .form-group-modern select:focus {
                outline: none;
                border-color: #1f2937;
                background: white;
                box-shadow: 0 0 0 4px rgba(31, 41, 55, 0.08);
                transform: translateY(-1px);
            }

            .form-group-modern input:hover,
            .form-group-modern textarea:hover,
            .form-group-modern select:hover {
                border-color: #9ca3af;
                background: white;
            }

        .form-group-modern .input-icon {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: #9ca3af;
            font-size: 18px;
        }

        .form-group-modern input.with-icon {
            padding-left: 44px;
        }

        .form-group-modern textarea {
            min-height: 80px;
            resize: vertical;
        }

    .field-validation-error {
        color: #dc2626;
        font-size: 13px;
        margin-top: 4px;
        display: block;
    }

    .validation-summary {
        background: #fef2f2;
        border: 1px solid #fecaca;
        border-radius: 8px;
        padding: 12px 16px;
        margin-bottom: 20px;
        color: #dc2626;
    }

        .validation-summary ul {
            margin: 0;
            padding-left: 20px;
        }

    .btn-primary {
        padding: 14px 32px;
        background: #1f2937;
        color: white;
        border: none;
        border-radius: 10px;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
    }

        .btn-primary:hover {
            background: #374151;
            transform: translateY(-2px);
            box-shadow: 0 4px 16px rgba(31, 41, 55, 0.25);
        }

        .btn-primary:active {
            transform: translateY(0);
        }

        .btn-primary:disabled {
            opacity: 0.6;
            cursor: not-allowed;
            transform: none;
        }

    .btn-success {
        padding: 14px 32px;
        background: #059669;
        color: white;
        border: none;
        border-radius: 10px;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
    }

        .btn-success:hover {
            background: #047857;
            transform: translateY(-2px);
            box-shadow: 0 4px 16px rgba(5, 150, 105, 0.25);
        }

        .btn-success:disabled {
            opacity: 0.6;
            cursor: not-allowed;
            transform: none;
        }

    .topic-grid {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        padding: 16px;
        background: #f9fafb;
        border-radius: 10px;
        border: 2px solid #e5e7eb;
        min-height: 60px;
    }

    .topic-card {
        display: inline-block;
        padding: 10px 20px;
        background: white;
        border: 2px solid #d1d5db;
        border-radius: 20px;
        cursor: pointer;
        transition: all 0.3s ease;
        font-size: 14px;
        font-weight: 500;
        color: #374151;
        user-select: none;
    }

        .topic-card:hover {
            transform: scale(0.95);
            background: #6b7280;
            color: white;
            border-color: #4b5563;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        }

        .topic-card.selected {
            transform: scale(0.95);
            background: #1f2937;
            color: white;
            border-color: #111827;
            box-shadow: 0 2px 12px rgba(31, 41, 55, 0.2);
        }

            .topic-card.selected:hover {
                background: #374151;
            }

        .topic-card input[type="checkbox"] {
            display: none;
        }

    .topic-grid.max-selected .topic-card:not(.selected):hover {
        transform: scale(0.95);
        background: #9ca3af;
        cursor: not-allowed;
        opacity: 0.6;
    }

    .topic-counter {
        text-align: center;
        font-size: 14px;
        color: #6b7280;
        margin-bottom: 10px;
    }

        .topic-counter .count {
            font-weight: 700;
            color: #1f2937;
            font-size: 16px;
        }

    .section-divider {
        border: none;
        border-top: 2px solid #e5e7eb;
        margin: 24px 0;
    }

    .otp-section {
        background: #f0fdf4;
        border: 2px solid #bbf7d0;
        border-radius: 10px;
        padding: 16px;
        margin-top: 16px;
    }

        .otp-section .otp-title {
            font-weight: 600;
            color: #16a34a;
            margin-bottom: 8px;
        }

    .btn-actions {
        display: flex;
        gap: 12px;
        margin-top: 20px;
        flex-wrap: wrap;
    }

    .spinner {
        display: inline-block;
        width: 18px;
        height: 18px;
        border: 3px solid rgba(255, 255, 255, 0.3);
        border-radius: 50%;
        border-top-color: #fff;
        animation: spin 0.8s ease-in-out infinite;
        margin-right: 8px;
        vertical-align: middle;
    }

    @@keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }

    @@media (max-width: 640px) {
        .edit-profile-container {
            padding: 0 16px;
        }

        .btn-actions {
            flex-direction: column;
        }

            .btn-actions button {
                width: 100%;
            }
    }
</style>

<div class="edit-profile-container">
    <h1 class="edit-profile-title">@ViewData["Title"]</h1>
    <p class="edit-profile-subtitle">@Localizer["Actualizează-ți informațiile de profil"]</p>

    <partial name="_StatusMessage" for="StatusMessage" />

    <form id="profile-form" method="post">
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

        @if (Model.CanEditTopics)
        {
            <div class="form-group-modern">
                <h5 style="margin-bottom: 4px; color: #1f2937;">@Localizer["Materiile Tale de Interes"]</h5>
                <p style="color: #6b7280; font-size: 14px; margin-bottom: 10px;">@Localizer["Selectează până la 3 materii care te interesează"]</p>

                <div class="topic-counter">
                    @Localizer["Selectate:"] <span class="count" id="selectedCount">@Model.SelectedTopicIds.Count</span> / 3
                </div>

                <div class="topic-grid" id="topicsGrid">
                    @foreach (var topic in Model.AvailableTopics)
                    {
                        var isSelected = Model.SelectedTopicIds.Contains(topic.Id);
                        <label class="topic-card @(isSelected ? "selected" : "")" data-topic-id="@topic.Id">
                            <input type="checkbox"
                                   name="SelectedTopicIds"
                                   value="@topic.Id"
                            @(isSelected ? "checked" : "")
                                   onchange="handleTopicToggle(this)" />
                            <span>@topic.Name</span>
                        </label>
                    }
                </div>
                <span asp-validation-for="SelectedTopicIds" class="field-validation-error"></span>
            </div>
            <hr class="section-divider" />
        }

        @if (Model.IsLearnUser)
        {
            <div class="form-group-modern">
                <label asp-for="EducationLevel">@Localizer["Nivel de studii"]</label>
                <select asp-for="EducationLevel">
                    <option value="">@Localizer["Selectează nivelul tău de studii..."]</option>
                    <option value="High School">@Localizer["Liceu"]</option>
                    <option value="Some College">@Localizer["Facultate neterminată"]</option>
                    <option value="College Graduate">@Localizer["Absolvent de facultate"]</option>
                    <option value="University Student">@Localizer["Student"]</option>
                    <option value="Graduate Student">@Localizer["Masterand"]</option>
                    <option value="PhD">@Localizer["Doctorat"]</option>
                    <option value="Self-Taught">@Localizer["Autodidact"]</option>
                </select>
                <span asp-validation-for="EducationLevel" class="field-validation-error"></span>
            </div>
            <hr class="section-divider" />
        }

        @if (Model.IsTeachUser)
        {
            <div class="form-group-modern">
                <label asp-for="TeachingLevel">@Localizer["Nivel de experiență"]</label>
                <select asp-for="TeachingLevel">
                    <option value="">@Localizer["Selectează nivelul tău de experiență..."]</option>
                    <option value="Beginner">@Localizer["Începător"]</option>
                    <option value="Intermediate">@Localizer["Intermediar"]</option>
                    <option value="Advanced">@Localizer["Avansat"]</option>
                    <option value="Expert">@Localizer["Expert"]</option>
                    <option value="Professional">@Localizer["Profesionist"]</option>
                </select>
                <span asp-validation-for="TeachingLevel" class="field-validation-error"></span>
            </div>
            <hr class="section-divider" />
        }

        <div class="form-group-modern">
            <label asp-for="Username">@Localizer["Nume de utilizator"]</label>
            <div class="input-wrapper">
                <input asp-for="Username" class="with-icon" placeholder="@Localizer["Introdu numele de utilizator"]" />
            </div>
            <span asp-validation-for="Username" class="field-validation-error"></span>
        </div>

        <div class="form-group-modern">
            <label asp-for="Email">@Localizer["Adresă de email"]</label>
            <div class="input-wrapper">
                <input asp-for="Email" class="with-icon" placeholder="@Localizer["Introdu emailul"]" />
            </div>
            <span asp-validation-for="Email" class="field-validation-error"></span>
        </div>

        @if (Model.ShowOtpInput)
        {
            <div class="otp-section">
                <div class="otp-title">@Localizer["Verificare Necesară"]</div>
                <p style="font-size: 14px; color: #374151; margin-bottom: 12px;">
                    @Localizer["Introdu codul din 6 cifre trimis pe emailul tău pentru a confirma modificările"]
                </p>
                <div class="form-group-modern" style="margin-bottom: 0;">
                    <label asp-for="OtpCode">@Localizer["Cod de verificare"]</label>
                    <div class="input-wrapper">
                        <input asp-for="OtpCode" class="with-icon" placeholder="@Localizer["Introdu codul din 6 cifre"]" maxlength="6" inputmode="numeric" />
                    </div>
                    <span asp-validation-for="OtpCode" class="field-validation-error"></span>
                </div>
            </div>
        }

        <div class="btn-actions">
            @if (Model.ShowOtpInput)
            {
                <button type="submit" asp-page-handler="SaveChanges" class="btn-success" id="saveBtn">
                    <span class="spinner" id="saveSpinner" style="display: none;"></span>
                    <span id="saveText">@Localizer["Salvează Modificările"]</span>
                </button>
            }
            else
            {
                <button type="submit" asp-page-handler="SendCode" class="btn-primary" id="sendCodeBtn">
                    <span class="spinner" id="sendSpinner" style="display: none;"></span>
                    <span id="sendText">@Localizer["Trimite Cod de Verificare"]</span>
                </button>
            }
        </div>
    </form>
</div>

@* Clear status message after displaying it *@
@{
    if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        Model.StatusMessage = null;
    }
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const i18n = @Html.Raw(Json.Serialize(i18n));

        function handleTopicToggle(checkbox) {
            const label = checkbox.closest('.topic-card');
            const topicsGrid = document.getElementById('topicsGrid');
            const selectedCheckboxes = topicsGrid.querySelectorAll('input[type="checkbox"]:checked');
            const currentCount = selectedCheckboxes.length;

            if (checkbox.checked && currentCount > 3) {
                checkbox.checked = false;
                alert(i18n.maxTopics);
                return;
            }

            if (checkbox.checked) {
                label.classList.add('selected');
            } else {
                label.classList.remove('selected');
            }

            const updatedCount = topicsGrid.querySelectorAll('input[type="checkbox"]:checked').length;
            document.getElementById('selectedCount').textContent = updatedCount;

            if (updatedCount >= 3) {
                topicsGrid.classList.add('max-selected');
                topicsGrid.querySelectorAll('input[type="checkbox"]:not(:checked)').forEach(cb => {
                    cb.disabled = true;
                    cb.closest('.topic-card').style.cursor = 'not-allowed';
                    cb.closest('.topic-card').style.opacity = '0.6';
                });
            } else {
                topicsGrid.classList.remove('max-selected');
                topicsGrid.querySelectorAll('input[type="checkbox"]').forEach(cb => {
                    cb.disabled = false;
                    cb.closest('.topic-card').style.cursor = 'pointer';
                    cb.closest('.topic-card').style.opacity = '1';
                });
            }
        }

        document.addEventListener('DOMContentLoaded', function() {
            const topicsGrid = document.getElementById('topicsGrid');
            if (topicsGrid) {
                const checked = topicsGrid.querySelectorAll('input[type="checkbox"]:checked').length;
                document.getElementById('selectedCount').textContent = checked;

                if (checked >= 3) {
                    topicsGrid.classList.add('max-selected');
                    topicsGrid.querySelectorAll('input[type="checkbox"]:not(:checked)').forEach(cb => {
                        cb.disabled = true;
                        cb.closest('.topic-card').style.cursor = 'not-allowed';
                        cb.closest('.topic-card').style.opacity = '0.6';
                    });
                }
            }
        });

        document.querySelector('form').addEventListener('submit', function(e) {
            const sendBtn = document.getElementById('sendCodeBtn');
            const saveBtn = document.getElementById('saveBtn');

            if (sendBtn) {
                const spinner = document.getElementById('sendSpinner');
                const text = document.getElementById('sendText');
                sendBtn.disabled = true;
                spinner.style.display = 'inline-block';
                text.textContent = i18n.sending;
                sendBtn.style.opacity = '0.7';
            }

            if (saveBtn) {
                const spinner = document.getElementById('saveSpinner');
                const text = document.getElementById('saveText');
                saveBtn.disabled = true;
                spinner.style.display = 'inline-block';
                text.textContent = i18n.saving;
                saveBtn.style.opacity = '0.7';
            }
        });

        document.querySelectorAll('.form-group-modern input').forEach(input => {
            input.addEventListener('focus', function() {
                const label = this.closest('.form-group-modern')?.querySelector('label');
                if (label) label.style.color = '#1f2937';
            });
            input.addEventListener('blur', function() {
                const label = this.closest('.form-group-modern')?.querySelector('label');
                if (label) label.style.color = '#374151';
            });
        });
    </script>
}
