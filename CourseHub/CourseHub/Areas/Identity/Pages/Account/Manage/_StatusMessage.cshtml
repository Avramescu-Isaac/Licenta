@model string

@if (!string.IsNullOrEmpty(Model))
{
    <div class="status-message @(Model.StartsWith("Error") ? "error" : "success")">
        <div class="status-message-content">
            <span class="status-text">@Model</span>
        </div>
    </div>
}

<style>
    .status-message {
        padding: 12px 16px;
        border-radius: 10px;
        margin-bottom: 20px;
        border: none;
        animation: slideDown 0.3s ease;
    }

        .status-message.success {
            background: #f0fdf4;
            border-left: 4px solid #16a34a;
            color: #16a34a;
        }

        .status-message.error {
            background: #fef2f2;
            border-left: 4px solid #dc2626;
            color: #dc2626;
        }

    .status-message-content {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .status-icon {
        font-size: 18px;
        flex-shrink: 0;
    }

    .status-text {
        font-size: 14px;
        font-weight: 500;
    }

    @@keyframes slideDown {
        from {
            opacity: 0;
            transform: translateY(-10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>