@page
@model CourseHub.Areas.Identity.Pages.Account.ConfirmOtpModel
@{
    ViewData["Title"] = Localizer["Confirmă-ți contul"];
}

<h1>@ViewData["Title"]</h1>
<p>@Localizer["Introdu codul de confirmare pe care ți l-am trimis prin email."]</p>

<form method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <input type="hidden" asp-for="Input.UserId" />

    <div class="form-group mb-3">
        <label asp-for="Input.Code">@Localizer["Cod de confirmare"]</label>
        <input asp-for="Input.Code" class="form-control" autocomplete="off" />
        <span asp-validation-for="Input.Code" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">@Localizer["Confirmă"]</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
