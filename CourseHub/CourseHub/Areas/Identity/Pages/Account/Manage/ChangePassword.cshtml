@page
@model CourseHub.Areas.Identity.Pages.Account.Manage.ChangePasswordModel
@{
    ViewData["Title"] = Localizer["Schimbă Parola"];
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
    var updatingText = Localizer["Se actualizează..."].Value;
}

<style>
    .change-password-container {
        max-width: 520px;
        margin: 0 auto;
        padding: 20px 0;
    }

    .change-password-title {
        color: #1f2937;
        font-size: 24px;
        font-weight: 700;
        margin-bottom: 8px;
    }

    .change-password-subtitle {
        color: #6b7280;
        font-size: 15px;
        margin-bottom: 24px;
    }

    .form-group-modern {
        margin-bottom: 20px;
    }

        .form-group-modern label {
            display: block;
            font-weight: 500;
            color: #374151;
            margin-bottom: 6px;
            font-size: 14px;
        }

        .form-group-modern .input-wrapper {
            position: relative;
        }

        .form-group-modern input {
            width: 100%;
            padding: 12px 16px;
            padding-left: 44px;
            border: 2px solid #e5e7eb;
            border-radius: 10px;
            font-size: 15px;
            transition: all 0.3s ease;
            background: #f9fafb;
            box-sizing: border-box;
        }

            .form-group-modern input:focus {
                outline: none;
                border-color: #1f2937;
                background: white;
                box-shadow: 0 0 0 4px rgba(31, 41, 55, 0.08);
                transform: translateY(-1px);
            }

            .form-group-modern input:hover {
                border-color: #9ca3af;
                background: white;
            }

        .form-group-modern .input-icon {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: #9ca3af;
            font-size: 18px;
        }

    .field-validation-error {
        color: #dc2626;
        font-size: 13px;
        margin-top: 4px;
        display: block;
    }

    .validation-summary {
        background: #fef2f2;
        border: 1px solid #fecaca;
        border-radius: 8px;
        padding: 12px 16px;
        margin-bottom: 20px;
        color: #dc2626;
    }

        .validation-summary ul {
            margin: 0;
            padding-left: 20px;
        }

    .status-message {
        padding: 12px 16px;
        border-radius: 8px;
        margin-bottom: 20px;
    }

        .status-message.success {
            background: #f0fdf4;
            border: 1px solid #bbf7d0;
            color: #16a34a;
        }

        .status-message.error {
            background: #fef2f2;
            border: 1px solid #fecaca;
            color: #dc2626;
        }

    .btn-submit {
        width: 100%;
        padding: 14px;
        background: #1f2937;
        color: white;
        border: none;
        border-radius: 10px;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        margin-top: 8px;
    }

        .btn-submit:hover {
            background: #374151;
            transform: translateY(-2px);
            box-shadow: 0 4px 16px rgba(31, 41, 55, 0.25);
        }

        .btn-submit:active {
            transform: translateY(0);
        }

        .btn-submit:disabled {
            opacity: 0.6;
            cursor: not-allowed;
            transform: none;
        }

    .password-strength {
        height: 4px;
        border-radius: 2px;
        margin-top: 6px;
        background: #e5e7eb;
        transition: all 0.3s;
        overflow: hidden;
    }

        .password-strength .bar {
            height: 100%;
            width: 0%;
            border-radius: 2px;
            transition: width 0.4s ease;
        }

            .password-strength .bar.weak {
                width: 33%;
                background: #dc2626;
            }

            .password-strength .bar.medium {
                width: 66%;
                background: #f59e0b;
            }

            .password-strength .bar.strong {
                width: 100%;
                background: #16a34a;
            }

    .toggle-password {
        position: absolute;
        right: 14px;
        top: 50%;
        transform: translateY(-50%);
        background: none;
        border: none;
        color: #9ca3af;
        cursor: pointer;
        font-size: 18px;
        padding: 4px;
        transition: all 0.2s;
    }

        .toggle-password:hover {
            color: #374151;
        }

    .spinner {
        display: inline-block;
        width: 18px;
        height: 18px;
        border: 3px solid rgba(255, 255, 255, 0.3);
        border-radius: 50%;
        border-top-color: #fff;
        animation: spin 0.8s ease-in-out infinite;
        margin-right: 8px;
        vertical-align: middle;
    }

    @@keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }

    @@media (max-width: 640px) {
        .change-password-container {
            padding: 0 16px;
        }
    }
</style>

<div class="change-password-container">
    <h1 class="change-password-title">@ViewData["Title"]</h1>
    <p class="change-password-subtitle">@Localizer["Actualizează-ți parola pentru a-ți menține contul securizat"]</p>

    <partial name="_StatusMessage" for="StatusMessage" />

    <form id="change-password-form" method="post">
        <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>

        <div class="form-group-modern">
            <label asp-for="Input.OldPassword">@Localizer["Parola Actuală"]</label>
            <div class="input-wrapper">
                <input asp-for="Input.OldPassword" id="oldPassword" class="form-control" autocomplete="current-password" aria-required="true" placeholder="@Localizer["Introdu parola actuală"]" />
                <button type="button" class="toggle-password" onclick="togglePassword('oldPassword')">@Localizer["Arată"]</button>
            </div>
            <span asp-validation-for="Input.OldPassword" class="field-validation-error"></span>
        </div>

        <div class="form-group-modern">
            <label asp-for="Input.NewPassword">@Localizer["Parolă Nouă"]</label>
            <div class="input-wrapper">
                <input asp-for="Input.NewPassword" id="newPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="@Localizer["Creează o parolă nouă"]" oninput="checkPasswordStrength(this.value)" />
                <button type="button" class="toggle-password" onclick="togglePassword('newPassword')">@Localizer["Arată"]</button>
            </div>
            <div class="password-strength" id="strengthIndicator">
                <div class="bar" id="strengthBar"></div>
            </div>
            <span asp-validation-for="Input.NewPassword" class="field-validation-error"></span>
        </div>

        <div class="form-group-modern">
            <label asp-for="Input.ConfirmPassword">@Localizer["Confirmă Parola Nouă"]</label>
            <div class="input-wrapper">
                <input asp-for="Input.ConfirmPassword" id="confirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="@Localizer["Confirmă noua parolă"]" />
                <button type="button" class="toggle-password" onclick="togglePassword('confirmPassword')">@Localizer["Arată"]</button>
            </div>
            <span asp-validation-for="Input.ConfirmPassword" class="field-validation-error"></span>
        </div>

        <button type="submit" class="btn-submit" id="submitBtn">
            <span class="spinner" id="submitSpinner" style="display: none;"></span>
            <span id="submitText">@Localizer["Actualizează Parola"]</span>
        </button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const updatingText = @Html.Raw(Json.Serialize(updatingText));

        // Toggle password visibility
        function togglePassword(inputId) {
            const input = document.getElementById(inputId);
            const button = event.target;
            if (input.type === 'password') {
                input.type = 'text';
                button.textContent = 'Ascunde';
            } else {
                input.type = 'password';
                button.textContent = 'Arată';
            }
        }

        // Password strength checker
        function checkPasswordStrength(password) {
            const bar = document.getElementById('strengthBar');
            if (!bar) return;

            let strength = 0;
            if (password.length >= 8) strength++;
            if (password.match(/[a-z]/)) strength++;
            if (password.match(/[A-Z]/)) strength++;
            if (password.match(/[0-9]/)) strength++;
            if (password.match(/[^a-zA-Z0-9]/)) strength++;

            bar.className = 'bar';
            if (password.length === 0) {
                bar.style.width = '0%';
                return;
            }

            if (strength <= 2) {
                bar.classList.add('weak');
            } else if (strength <= 3) {
                bar.classList.add('medium');
            } else {
                bar.classList.add('strong');
            }
        }

        // Form submit handling
        document.querySelector('form').addEventListener('submit', function() {
            const btn = document.getElementById('submitBtn');
            const spinner = document.getElementById('submitSpinner');
            const text = document.getElementById('submitText');

            btn.disabled = true;
            spinner.style.display = 'inline-block';
            text.textContent = updatingText;
            btn.style.opacity = '0.7';
        });

        // Add focus effects
        document.querySelectorAll('.form-group-modern input').forEach(input => {
            input.addEventListener('focus', function() {
                const label = this.closest('.form-group-modern')?.querySelector('label');
                if (label) label.style.color = '#1f2937';
            });
            input.addEventListener('blur', function() {
                const label = this.closest('.form-group-modern')?.querySelector('label');
                if (label) label.style.color = '#374151';
            });
        });
    </script>
}
