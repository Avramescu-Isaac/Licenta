@page
@model ResetPasswordConfirmationModel
@{
    ViewData["Title"] = Localizer["Confirmare Resetare Parolă"];
}

<style>
    .confirmation-container {
        max-width: 440px;
        margin: 80px auto;
        padding: 48px 40px;
        background: white;
        border-radius: 16px;
        box-shadow: 0 4px 24px rgba(0, 0, 0, 0.08);
        text-align: center;
    }

    .confirmation-icon {
        font-size: 72px;
        display: block;
        margin-bottom: 16px;
    }

    .confirmation-title {
        color: #1f2937;
        font-size: 26px;
        font-weight: 700;
        margin-bottom: 8px;
    }

    .confirmation-subtitle {
        color: #6b7280;
        font-size: 16px;
        margin-bottom: 32px;
        line-height: 1.6;
    }

    .btn-login {
        display: inline-block;
        padding: 14px 48px;
        background: #1f2937;
        color: white;
        border: none;
        border-radius: 10px;
        font-size: 16px;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.3s ease;
    }

        .btn-login:hover {
            background: #374151;
            transform: translateY(-2px);
            box-shadow: 0 4px 16px rgba(31, 41, 55, 0.25);
        }

        .btn-login:active {
            transform: translateY(0);
        }

    @@media (max-width: 640px) {
        .confirmation-container {
            padding: 32px 24px;
            margin: 20px 16px;
        }
    }
</style>

<div class="confirmation-container">
    <h1 class="confirmation-title">@Localizer["Parolă Resetată cu Succes!"]</h1>
    <p class="confirmation-subtitle">
        @Localizer["Parola ta a fost resetată cu succes."]<br />
        @Localizer["Te poți autentifica acum cu noua parolă."]
    </p>
    <a asp-page="./Login" class="btn-login">@Localizer["Autentifică-te Acum"]</a>
</div>
