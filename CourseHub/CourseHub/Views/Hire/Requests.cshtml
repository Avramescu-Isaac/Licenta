@model IEnumerable<CourseHub.Models.HireRequest>
@{
    var isTeach = ViewBag.IsTeach as bool? ?? false;
    ViewData["Title"] = isTeach ? Localizer["Cereri de colaborare"] : Localizer["Cererile mele"];
}

<style>
    .requests-page {
        max-width: 800px;
        margin: 0 auto;
        padding: 20px 0 40px;
    }

    .requests-title {
        color: #1f2937;
        font-size: 26px;
        font-weight: 700;
        margin-bottom: 4px;
        text-align: center;
    }

    .requests-subtitle {
        color: #6b7280;
        font-size: 15px;
        margin-bottom: 28px;
        text-align: center;
    }

    .requests-list {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .request-card {
        background: white;
        border-radius: 14px;
        border: 2px solid #f3f4f6;
        padding: 16px 18px;
        display: flex;
        align-items: center;
        gap: 14px;
        transition: all 0.3s ease;
    }

        .request-card:hover {
            border-color: #e5e7eb;
            box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06);
            transform: translateY(-2px);
        }

    .request-avatar {
        width: 52px;
        height: 52px;
        border-radius: 50%;
        background: #1f2937;
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        font-weight: 700;
        flex-shrink: 0;
        overflow: hidden;
    }

        .request-avatar img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .request-info {
        flex: 1;
        min-width: 0;
    }

    .request-name {
        font-weight: 600;
        color: #1f2937;
        font-size: 16px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .request-date {
        color: #9ca3af;
        font-size: 13px;
        margin-top: 2px;
    }

    .request-actions {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-shrink: 0;
    }

    .btn-request-accept {
        padding: 10px 20px;
        background: #059669;
        color: white;
        border: none;
        border-radius: 10px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        flex-shrink: 0;
    }

        .btn-request-accept:hover {
            background: #047857;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(5, 150, 105, 0.25);
        }

    .btn-request-cancel {
        padding: 10px 20px;
        background: transparent;
        color: #dc2626;
        border: 1.5px solid #dc2626;
        border-radius: 10px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        flex-shrink: 0;
    }

        .btn-request-cancel:hover {
            background: #dc2626;
            color: white;
        }

    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        font-size: 12px;
        font-weight: 700;
        padding: 6px 14px;
        border-radius: 20px;
        flex-shrink: 0;
    }

        .status-badge.pending {
            background: #fef3c7;
            color: #b45309;
        }

        .status-badge.accepted {
            background: #f0fdf4;
            color: #16a34a;
        }

    .empty-state {
        text-align: center;
        padding: 60px 20px;
        color: #9ca3af;
    }

        .empty-state .icon {
            font-size: 56px;
            display: block;
            margin-bottom: 12px;
        }

        .empty-state p {
            font-size: 15px;
        }

    @@media (max-width: 480px) {
        .request-card {
            flex-wrap: wrap;
        }

        .request-actions {
            width: 100%;
        }

        .btn-request-accept,
        .btn-request-cancel {
            width: 100%;
            justify-content: center;
        }
    }
</style>

<div class="requests-page">
    @if (isTeach)
    {
        <h1 class="requests-title">@Localizer["Cereri de colaborare"]</h1>
        <p class="requests-subtitle">@Localizer["Elevi care vor să înveți cu ei"]</p>
    }
    else
    {
        <h1 class="requests-title">@Localizer["Cererile mele"]</h1>
        <p class="requests-subtitle">@Localizer["Profesorii cărora le-ai trimis o cerere"]</p>
    }

    @{
        var requestList = Model.ToList();
    }

    @if (requestList.Count == 0)
    {
        <div class="empty-state">
            @if (isTeach)
            {
                <p>@Localizer["Nu ai nicio cerere în așteptare."]</p>
            }
            else
            {
                <p>@Localizer["Nu ai trimis nicio cerere încă. Caută un profesor și apasă Trimite cerere."]</p>
            }
        </div>
    }
    else if (isTeach)
    {
        <div class="requests-list">
            @foreach (var request in requestList)
            {
                var requesterName = request.Requester?.UserName ?? "?";
                var initial = requesterName.Length > 0 ? requesterName[0].ToString().ToUpper() : "?";
                <div class="request-card">
                    <div class="request-avatar">
                        @if (!string.IsNullOrEmpty(request.Requester?.AvatarPath))
                        {
                            <img src="@request.Requester.AvatarPath" alt="" />
                        }
                        else
                        {
                            @initial
                        }
                    </div>
                    <div class="request-info">
                        <div class="request-name">@requesterName</div>
                        <div class="request-date">@request.RequestedAt.ToString("dd MMM yyyy")</div>
                    </div>
                    <div class="request-actions">
                        <form asp-action="Accept" asp-controller="Hire" method="post">
                            <input type="hidden" name="id" value="@request.Id" />
                            <button type="submit" class="btn-request-accept">@Localizer["Acceptă"]</button>
                        </form>
                        <form asp-action="Reject" asp-controller="Hire" method="post">
                            <input type="hidden" name="id" value="@request.Id" />
                            <button type="submit" class="btn-request-cancel">@Localizer["Respinge"]</button>
                        </form>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="requests-list">
            @foreach (var request in requestList)
            {
                var targetName = request.Target?.UserName ?? "?";
                var initial = targetName.Length > 0 ? targetName[0].ToString().ToUpper() : "?";
                <div class="request-card">
                    <div class="request-avatar">
                        @if (!string.IsNullOrEmpty(request.Target?.AvatarPath))
                        {
                            <img src="@request.Target.AvatarPath" alt="" />
                        }
                        else
                        {
                            @initial
                        }
                    </div>
                    <div class="request-info">
                        <div class="request-name">@targetName</div>
                        <div class="request-date">@request.RequestedAt.ToString("dd MMM yyyy")</div>
                    </div>
                    @if (request.IsAccepted)
                    {
                        <span class="status-badge accepted">@Localizer["Acceptat"]</span>
                    }
                    else
                    {
                        <span class="status-badge pending">⏳ @Localizer["În așteptare"]</span>
                        <form asp-action="Cancel" asp-controller="Hire" method="post">
                            <input type="hidden" name="id" value="@request.Id" />
                            <button type="submit" class="btn-request-cancel">@Localizer["Anulează"]</button>
                        </form>
                    }
                </div>
            }
        </div>
    }
</div>
