@model List<CourseHub.Models.ApplicationUser>

@{
    ViewData["Title"] = Localizer["Mesaje primite"];
    var unreadBySender = ViewBag.UnreadBySender as Dictionary<string, int> ?? new Dictionary<string, int>();
}

<style>
    .inbox-page {
        max-width: 720px;
        margin: 0 auto;
        padding: 20px 0 40px;
    }

    .inbox-title {
        color: #1f2937;
        font-size: 26px;
        font-weight: 700;
        margin-bottom: 4px;
        text-align: center;
    }

    .inbox-subtitle {
        color: #6b7280;
        font-size: 15px;
        margin-bottom: 28px;
        text-align: center;
    }

    .inbox-list {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .inbox-card {
        background: white;
        border-radius: 14px;
        border: 2px solid #f3f4f6;
        padding: 16px 18px;
        display: flex;
        align-items: center;
        gap: 14px;
        text-decoration: none;
        transition: all 0.3s ease;
    }

        .inbox-card:hover {
            border-color: #e5e7eb;
            box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06);
            transform: translateY(-2px);
            text-decoration: none;
        }

        .inbox-card.unread {
            border-color: #dbeafe;
            background: #f8fbff;
        }

    .inbox-avatar {
        width: 52px;
        height: 52px;
        border-radius: 50%;
        background: #1f2937;
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        font-weight: 700;
        flex-shrink: 0;
        overflow: hidden;
    }

        .inbox-avatar img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .inbox-info {
        flex: 1;
        min-width: 0;
    }

    .inbox-name {
        font-weight: 600;
        color: #1f2937;
        font-size: 16px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .inbox-email {
        color: #9ca3af;
        font-size: 13px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        margin-top: 2px;
    }

    .inbox-unread-badge {
        min-width: 22px;
        height: 22px;
        padding: 0 6px;
        background: #dc2626;
        color: white;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 700;
        line-height: 22px;
        text-align: center;
        flex-shrink: 0;
    }

    .btn-inbox-open {
        padding: 9px 18px;
        background: #1f2937;
        color: white;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
        flex-shrink: 0;
    }

    .empty-state {
        text-align: center;
        padding: 60px 20px;
        color: #9ca3af;
    }

        .empty-state .icon {
            font-size: 56px;
            display: block;
            margin-bottom: 12px;
        }

        .empty-state p {
            font-size: 15px;
        }

    @@media (max-width: 480px) {
        .inbox-card {
            flex-wrap: wrap;
        }

        .btn-inbox-open {
            width: 100%;
            text-align: center;
        }
    }
</style>

<div class="inbox-page">
    <h1 class="inbox-title">@Localizer["Mesaje primite"]</h1>
    <p class="inbox-subtitle">@Localizer["Conversațiile tale recente"]</p>

    @if (Model.Count == 0)
    {
        <div class="empty-state">
            <p>@Localizer["Niciun mesaj încă."]</p>
        </div>
    }
    else
    {
        <div class="inbox-list">
            @foreach (var user in Model)
            {
                var initial = !string.IsNullOrEmpty(user.UserName) ? user.UserName[0].ToString().ToUpper() : "?";
                var unread = unreadBySender.TryGetValue(user.Id, out var c) ? c : 0;
                <a href="/Chat/WithUser?userId=@user.Id" class="inbox-card @(unread >0 ? "unread" : "")">
                    <div class="inbox-avatar">
                        @if (!string.IsNullOrEmpty(user.AvatarPath))
                        {
                            <img src="@user.AvatarPath" alt="" />
                        }
                        else
                        {
                            @initial
                        }
                    </div>
                    <div class="inbox-info">
                        <div class="inbox-name">@user.UserName</div>
                        <div class="inbox-email">@user.Email</div>
                    </div>
                    @if (unread > 0)
                    {
                        <span class="inbox-unread-badge">@(unread > 99 ? "99+" : unread.ToString())</span>
                    }
                    <span class="btn-inbox-open">@Localizer["Deschide"]</span>
                </a>
            }
        </div>
    }
</div>
